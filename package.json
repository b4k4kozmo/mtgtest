{
  "name": "mtg-price-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Search any Magic: The Gathering card and find the cheapest genuine listing across reputable vendors.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "build:static": "node scripts/build-static.mjs",
    "serve:static": "node scripts/build-static.mjs && node -e \"const h=require('node:http'),f=require('node:fs'),p=require('node:path');h.createServer((q,s)=>{const r=p.join('dist',q.url==='/'?'index.html':q.url.split('?')[0]);f.readFile(r,(e,b)=>{if(e){s.writeHead(404);return s.end()}s.writeHead(200,{'Content-Type':{'.html':'text/html; charset=utf-8','.css':'text/css; charset=utf-8','.js':'text/javascript; charset=utf-8'}[p.extname(r)]||'application/octet-stream'});s.end(b)})}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
