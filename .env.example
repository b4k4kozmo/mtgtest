# Port for the web server (default 3000)
PORT=3000

# ---------------------------------------------------------------------------
# Optional: eBay Browse API credentials.
#
# Without these the app still works: eBay appears as a pre-filtered deep link
# with proxy/custom-card keywords excluded. With them, the app pulls real live
# eBay listings (price + seller + listing photo) and shows them alongside the
# cheapest printings.
#
# Get keys at https://developer.ebay.com/ -> "Application Keys" (production).
# ---------------------------------------------------------------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace to query. EBAY_US, EBAY_GB, EBAY_DE, ...
EBAY_MARKETPLACE_ID=EBAY_US

# Contact string sent in the Scryfall User-Agent header (good API citizenship).
SCRYFALL_CONTACT=

# ---------------------------------------------------------------------------
# Shipping estimates.
#
# Only eBay reports a real per-listing shipping cost. For TCGplayer and
# Cardmarket there is no public per-seller quote, so the app applies a clearly
# labelled estimate that visitors can edit in the UI. These set the starting
# values. Leave SHIPPING_FREE_OVER_* unset for "no free-shipping threshold".
# ---------------------------------------------------------------------------
SHIPPING_PER_ORDER_USD=1.29
SHIPPING_FREE_OVER_USD=5
SHIPPING_PER_ORDER_EUR=1.50
SHIPPING_FREE_OVER_EUR=
